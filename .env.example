# trendarsa-app ile paylaşılan Supabase projesi (bkz. trendarsa-app/env.example.json)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# trendarsa-app'in kullandığı R2 public base URL ile aynı olmalı
R2_PUBLIC_BASE_URL=https://cdn.example.com

# Sadece scripts/seed-supabase.ts için — asla commit etmeyin, sadece yerelde kullanın.
# Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# scripts/seed-supabase.ts'in "created_by" için kullandığı, mevcut bir admin
# hesabının profiles.id'si (Supabase Studio > profiles tablosundan alın)
SEED_ADMIN_ID=YOUR_ADMIN_PROFILE_UUID
